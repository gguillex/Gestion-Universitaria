<?xml version="1.0" encoding="UTF-8"?>
<Context>
    <!-- Pool de conexiones JNDI. Los valores son los de una instalación local de
         XAMPP (usuario root sin contraseña): cámbialos para cualquier otro entorno. -->
    <Resource name="jdbc/gestion"
              auth="Container"
              type="javax.sql.DataSource"
              maxTotal="10"
              maxIdle="5"
              maxWaitMillis="10000"
              username="root"
              password=""
              driverClassName="com.mysql.cj.jdbc.Driver"
              url="jdbc:mysql://localhost:3306/gestion_universitaria?useSSL=false&amp;serverTimezone=UTC&amp;allowPublicKeyRetrieval=true"/>
</Context>
